@page "/account/registerUser"
@inject HttpClient httpClient
@inject NavigationManager navManager
@inject ToastService toastService

<h3 style="background-color: gray" class="text-center">Register User</h3>

<EditForm Model="@users" FormName="userRegisterForm" OnValidSubmit="RegisterUserAccount">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <hr />
    <div class="mb-3">
        <label for="userName" class="form-label">Name</label>
        <div class="col-md-4">
            <input type="text" @bind-value=users.Name />
            <ValidationMessage For="@(() => users.Name)" />
        </div>
    </div>
    <div class="mb-3">
        <label for="email" class="form-label">Email ID</label>
        <div class="col-md-4">
            <input type="text" @bind-value=users.Email />
            <ValidationMessage For="@(() => users.Email)" />
        </div>
    </div>
    <div class="mb-3">
        <label for="phoneNumber" class="form-label">Phone</label>
        <div class="col-md-4">
            <input type="text" maxlength="10" @bind-value=users.PhoneNumber />
            <ValidationMessage For="@(() => users.PhoneNumber)" />
        </div>
    </div>
    <div class="mb-3">
        <label for="password" class="form-label">Password</label>
        <div class="col-md-4">
            <input type="password" maxlength="10" @bind-value=users.Password />
            <ValidationMessage For="@(() => users.Password)" />
        </div>
    </div>
    <div class="mb-3">
        <label for="confirmPassword" class="form-label">Confirm Password</label>
        <div class="col-md-4">
            <input type="text" maxlength="10" @bind-value=users.ConfirmPassword />
            <ValidationMessage For="@(() => users.ConfirmPassword)" />
        </div>
    </div>
    <div class="form-group">
        <button type="submit" class="btn btn-primary">Save</button>
        <button type="button" class="btn btn-light" @onclick="Cancel">Cancel</button>
    </div>
</EditForm>

@code {
    private Users users;

    protected override void OnInitialized()
    {
        users = new();
    }

    protected async Task RegisterUserAccount()
    {
        var response = await httpClient.PostAsJsonAsync("api/Account", users);
        if (response.IsSuccessStatusCode)
            toastService.ShowToast("User registered successfully", ToastLevel.Success);
            else
            toastService.ShowToast("Register user failed!!!", ToastLevel.Error);
        Cancel();
    }

    public void Cancel()
    {
        navManager.NavigateTo("/");
    }
}
