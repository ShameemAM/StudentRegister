@page "/student/studentList"
@inject HttpClient Http
@inject Blazored.LocalStorage.ILocalStorageService localStorage
@inject ToastService toastService

<h3 style="background-color: gray" class="text-center">Student List</h3>
@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <p class="text-danger">@errorMessage</p>
}
<div class="row">
    <div class="col-md-6">
        <a href='/student/registerStudent' class="btn btn-primary" role="button">
            <i class="fas fa-user-plus"></i>
            Register New
        </a>
    </div>
</div>
@if (studentList.Count == 0)
{
    <p><em>Empty...</em></p>
} 
else
{
    <table class="table table-striped align-middle table-bordered" style="background-color:darkgray">
        <thead class="table-success">
            <tr>
                <th>ID</th>
                <th>StudentName</th>
                <th>EmailId</th>
                <th>Phone</th>
                <th>Date of Birth</th>
                <th>City</th>
                <th>Country</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in studentList)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.FirstName @item.LastName</td>
                    <td>@item.EmailId</td>
                    <td>@item.MobileNumber</td>
                    <td>@item.DateOfBirth.ToShortDateString()</td>
                    <td>@item.City</td>
                    <td>@item.Country</td>
                    <td>
                        <a href='/student/editStudent/@item.Id' class="btn btn-outline-dark" role="button">
                            Edit
                        </a>
                        <a href='/student/deleteStudent/@item.Id' class="btn btn-outline-danger" role="button">
                            Delete
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    protected List<StudentDetails> studentList = new();
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var token = await localStorage.GetItemAsync<string>("authToken");
        if (!string.IsNullOrWhiteSpace(token))
            Http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
        await GetStudents();
    }
    protected async Task GetStudents()
    {
        var response = await Http.GetAsync("api/Students");
        if (response.IsSuccessStatusCode)
            studentList = await response.Content.ReadFromJsonAsync<List<StudentDetails>>();
        else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            errorMessage = "You have no permission, please login";
            toastService.ShowToast("You have no permission", ToastLevel.Warning);
        }
        else if (!response.IsSuccessStatusCode)
        {
            errorMessage = "The operation failed to execute";
            toastService.ShowToast("The operation failed to execute", ToastLevel.Error);
        }
    }
}
