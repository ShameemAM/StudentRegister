@page "/student/deleteStudent/{id:int}"
@inject HttpClient http
@inject NavigationManager navManager
@inject Blazored.LocalStorage.ILocalStorageService localStorage
@inject ToastService toastService

<h2 style="background-color: gray" class="text-center">@($"Delete Student")</h2>

<br />
@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <p class="text-danger">@errorMessage</p>
}

<div class="form-group" style="background-color:burlywood">
    <h4>Do you want to delete this student?</h4>
    <table class="table">
        <tbody>
            <tr>
                <td>Id</td>
                <td>@student?.StudentModel?.Id</td>
            </tr>
            <tr>
                <td>Name</td>
                <td>@student?.StudentModel?.FirstName @student?.StudentModel?.LastName</td>
            </tr>
            <tr>
                <td>Email Id</td>
                <td>@student?.StudentModel?.EmailId</td>
            </tr>
            <tr>
                <td>Mobile Number</td>
                <td>@student?.StudentModel?.MobileNumber</td>
            </tr>
            <tr>
                <td>Date of Birth</td>
                <td>@student?.StudentModel?.DateOfBirth.ToShortDateString()</td>
            </tr>
            <tr>
                <td>Hobbies</td>
                <td>@String.Join(',',student?.StudentHobbiesModel?.Select(sh=>sh.Hobbie))</td>
            </tr>
            <tr>
                <td>ClassX Details</td>
                <td>Board: @student?.QualificationModel?.ClassXBord, Percentage: @student?.QualificationModel?.ClassXPercentage, Year of Pass: @student?.QualificationModel?.ClassXYearOfPassing</td>
            </tr>
            <tr>
                <td>ClassXII Details</td>
                <td>Board: @student?.QualificationModel?.ClassXIIBord, Percentage: @student?.QualificationModel?.ClassXIIPercentage, Year of Pass: @student?.QualificationModel?.ClassXIIYearOfPassing</td>
            </tr>
            <tr>
                <td>Graduation Details</td>
                <td>Board: @student?.QualificationModel?.GraduationBord, Percentage: @student?.QualificationModel?.GraduationPercentage, Year of Pass: @student?.QualificationModel?.GraduationYearOfPassing</td>
            </tr>
            <tr>
                <td>Masters Details</td>
                <td>Board: @student?.QualificationModel?.MastersBord, Percentage: @student?.QualificationModel?.MastersPercentage, Year of Pass: @student?.QualificationModel?.MastersYearOfPassing</td>
            </tr>
            <tr>
                <td>Applied Course</td>
                <td>@student?.CourseModel?.CourseName</td>
            </tr>
        </tbody>
    </table>
</div>
<div class="form-group">
    <input type="button" class="btn btn-danger" @onclick="(async () => await RemoveStudent(student.StudentModel.Id))" value="Delete" />
    <button type="submit" class="btn btn-light" @onclick="Cancel">Cancel</button>
</div>

@code {
    [Parameter]
    public int Id { get; set; }
    private Student student = new();
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var token = await localStorage.GetItemAsync<string>("authToken");
        if (!string.IsNullOrWhiteSpace(token))
            http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);

        var response = await http.GetAsync($"api/Students/{Id}");
        if (response.IsSuccessStatusCode)
            student = await response.Content.ReadFromJsonAsync<Student>();
        else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized){
            errorMessage = "You have no permission";
            toastService.ShowToast("You have no permission", ToastLevel.Warning);
        }
        else{
            errorMessage = "Some error occured!!!";
            toastService.ShowToast("Some error occured!!!", ToastLevel.Error);
        }
    }
    protected async Task RemoveStudent(int id)
    {
        var response = await http.DeleteAsync($"api/Students/{id}");
        if (response.IsSuccessStatusCode)
        {
            toastService.ShowToast("Deleted successfully", ToastLevel.Success);
        }
        else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            errorMessage = "You have no permission, please login";
            toastService.ShowToast("You have no permission", ToastLevel.Warning);
        }
        else if (!response.IsSuccessStatusCode)
        {
            errorMessage = "The operation failed to execute";
            toastService.ShowToast("The operation failed to execute", ToastLevel.Error);
        }
        Cancel();
    }

    public void Cancel()
    {
        navManager.NavigateTo("/student/studentList");
    }
}
