@page "/hobby/deleteHobby/{Id:int}"
@inject HttpClient Http
@inject NavigationManager navigationManager
@inject Blazored.LocalStorage.ILocalStorageService localStorage
@inject ToastService toastService

<h2 style="background-color: gray" class="text-center">@($"Delete Hobby")</h2>

<br />
@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <p class="text-danger">@errorMessage</p>
}

<div class="form-group" style="background-color:burlywood">
    <h4>Do you want to delete this hobby?</h4>
    <table class="table">
        <tbody>
            <tr>
                <td>Id</td>
                <td>@hobby.Id</td>
            </tr>
            <tr>
                <td>Hobby</td>
                <td>@hobby.Hobbie</td>
            </tr>
        </tbody>
    </table>
</div>
<div class="form-group">
    <input type="button" class="btn btn-danger" @onclick="(async () => await RemoveHobby(hobby.Id))" value="Delete" />
    <button type="submit" class="btn btn-light" @onclick="Cancel">Cancel</button>
</div>

@code {
    [Parameter]
    public int Id { get; set; }
    public Hobbies hobby = new Hobbies();
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var token = await localStorage.GetItemAsync<string>("authToken");
        if (!string.IsNullOrWhiteSpace(token))
            Http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
        var response = await Http.GetAsync($"api/Hobbies/{Id}");
        if (response.IsSuccessStatusCode)
            hobby = await response.Content.ReadFromJsonAsync<Hobbies>();
        else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized){
            errorMessage = "You have no permission";
            toastService.ShowToast("You have no permission", ToastLevel.Warning);
        }
        else{
            errorMessage = "Some error occured!!!";
            toastService.ShowToast("Some error occured!!!", ToastLevel.Error);
        }
    }

    protected async Task RemoveHobby(int id)
    {
        var response = await Http.DeleteAsync($"api/Hobbies/{id}");

        if (response.IsSuccessStatusCode)
        {
            toastService.ShowToast("Deleted successfully", ToastLevel.Success);
        }
        else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            errorMessage = "You have no permission, please login";
            toastService.ShowToast("You have no permission", ToastLevel.Warning);
        }
        else if (!response.IsSuccessStatusCode){
            errorMessage = "The operation failed to execute";
            toastService.ShowToast("The operation failed to execute", ToastLevel.Error);
        }
        Cancel();
    }

    public void Cancel()
    {
        navigationManager.NavigateTo("/hobby/hobbyList");
    }
}
